/******************************************************************************/
/************************** Misc Behavior Hacks *******************************/
/******************************************************************************/
/* Style used on focused item while dragging multiple chart objects. This MUST be defined below all other chart object CSS*/
.pssc .pssc-seatingAreaCanvas .pssc-objectDiv.draggingParent {
	border-style: none;		/* required */
	background: none;		/* required */
	box-shadow: none;		/* required */
}

.pssc .pssc-seatingAreaCanvas .pssc-objectDiv.draggingParent > .pssc-studentDiv,
.pssc .pssc-seatingAreaCanvas .pssc-objectDiv.draggingParent > img,
.pssc .pssc-seatingAreaCanvas .pssc-objectDiv.draggingParent > span,
.pssc .pssc-seatingAreaCanvas .pssc-objectDiv.draggingParent > input {
	visibility: hidden;		/* required */
}

/* Prevents the visual feedback of highlighting text/images in the seating chart. Though, they can still be selected (just without the visual highlighting). */
/* We have javascript prevention of "selectstart" events set up in uiManager, which works in Safari & IE. And the ::selection below for Safari & Opera. */
.pssc .pssc-studentList, .pssc .pssc-seatingAreaViewport, .pssc .pssc-zoomControlDiv {
	-moz-user-select: -moz-none;/* Firefox's 'none' does not allow child nodes to override. */
	-khtml-user-select: none;
	-webkit-user-select: none;	/* Supported in Chrome 1+ & Safari 3+ */
	-o-user-select: none;		/* NOT supported in Opera 11, and possibly never has in Opera. */
	-ms-user-select: none;		/* Supported in IE 10+ */
	user-select: none;			/* Not part of W3C CSS specs, but may be used. */
}

.pssc .pssc-textObjDiv input {
	-moz-user-select: text;
	-khtml-user-select: text;
	-webkit-user-select: text;
	-o-user-select: text;
	-ms-user-select: text;
	user-select: text;
}

/* ::selection works in Safari & Opera and prevents text from looking like it was highlighted. This doesn't prevent images or input fields from being highlighted. */
.pssc .pssc-studentDiv::selection, .pssc .pssc-objectDiv::selection, .pssc .pssc-zoomControlDiv::selection {
	background-color: transparent;
}


