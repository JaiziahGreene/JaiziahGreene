/******************************************************************************/
/******************** Outer Containing DOM Objects ****************************/
/******************************************************************************/
#content-main {
	padding-bottom: 0;
}

/* Seating Chart Outermost div */
.pssc {
	position: relative;		/* required */
}

/* Seating Chart Layout Name, only used during printing */
.pssc .pssc-layoutName {
	display: none;
}

/* Custom Content Injection Point not supported (aka. hidden) on this page as it inteferes with UI */
#cust-content-footer {
	display: none;
}


/******************************************************************************/
/******** Left Slider Drawing (Student List) & Student Holding Div ************/
/******************************************************************************/
/* Student List Selection (aka. Holding area) */
.pssc .pssc-sideMenuPanel {
	/* Styles overwritten in JS code: top, left, height, width, z-index */
	position: absolute;		/* required */
	padding: 0;				/* required */
	overflow: visible;		/* required */
	background-color: #E7E7E7;
	margin-top: 0;
	border-inline-end: 1px solid #999;
}

.pssc .pssc-populateStudentDiv {
	position: absolute;		/* required */
	top: 0;					/* required */
	left: 0;				/* required */
	width: 100%;			/* required */
	padding: 0;				/* required */
	display: block;			/* required */
	overflow: visible;		/* required */
	text-align: center;
	border-bottom: 1px solid #999;
	background-color: inherit;
	font-size: 13px;
}

.pssc .pssc-clearStudentDiv {
	position: absolute;		/* required */
	bottom: 0;				/* required */
	left: 0;				/* required */
	width: 100%;			/* required */
	padding: 0;				/* required */
	display: block;			/* required */
	overflow: visible;		/* required */
	text-align: center;
	border-top: 1px solid #999;
	background-color: inherit;
}

.pssc button.pssc-populateStudent, .pssc button.pssc-clearStudent {
	white-space: nowrap;
	margin-inline-start: 0;
}

.pssc button.pssc-populateStudent em, .pssc button.pssc-clearStudent em {
	float: right;
	margin: 0 -5px 0 2px;
}

[dir=rtl]  .pssc button.pssc-clearStudent em {
    float: left;
    margin: 0 2px 0 -4px;
}

[dir=rtl]  .pssc button.pssc-populateStudent em {
    float: left;
    margin: 0 2px 0 -4px;
}

.pssc .pssc-studentList {
	/* This is the holding area for the students whom have no seats assigned. */
	position: absolute;		/* required */
	top: 0;					/* required */
	left: 0;				/* required */
	width: 100%;			/* required */
	padding: 0;				/* required */
	display: block;			/* required */
	overflow: auto;			/* required */
	overflow-x: hidden;
	background-color: #eee;
}

.pssc .pssc-sideMenuPanel.collapsed .pssc-studentList, .pssc .pssc-sideMenuPanel.collapsed .pssc-populateStudentDiv, .pssc .pssc-sideMenuPanel.collapsed .pssc-clearStudentDiv, .pssc .ClassToolsMode .pssc-populateStudentDiv, .pssc .ClassToolsMode .pssc-clearStudentDiv {
	display: none;			/* required */
}

.pssc .pssc-studentList .pssc-studentHoldDiv {
	/* This is a single student item in the holding area (aka. not in a seat) */
	/* Styles overwritten in JS code: overflow, padding, width, height, margin */
	background: none repeat scroll 0 0 #FFF;
	border: 2px solid #333;
	-moz-border-radius: 5px;
	-webkit-border-radius: 5px;
	border-radius: 5px;
	padding: 0;
}

.pssc .pssc-studentHoldDiv.ui-draggable-dragging {
	/* This is the student item that is being dragged with the mouse (not the one in the hold area) */
	background-color: #fff;
	border: 2px solid #333;
	-moz-box-shadow: 0 0 .5em rgba(0, 0, 0, .8);
	-webkit-box-shadow: 0 0 .5em rgba(0, 0, 0, .8);
	box-shadow: 0 0 .5em rgba(0, 0, 0, .8);
	opacity: .6;
	filter: Alpha(Opacity = 60);
}

.pssc .pssc-studentHoldDiv.ui-draggable-dragging .pssc-studentMaskDiv {
	display: none;
}

.pssc .pssc-studentList .pssc-studentHoldDiv.dragging {
	/* This is the student item in the hold area while it's being dragged (not the one following the mouse) */
	border-color: #F93;
}

/* Styles for Navigation Collapse*/
.pssc .pssc-sideMenuPanel .pssc-studListHideToggle {
	/* Styles overwritten in JS code: left, z-index */
	position: absolute;	/* required */
	top: -1px;			/* required */
	height: 16px;
	width: 10px;
	background-color: inherit;
	z-index: 2;
	-moz-border-radius-topleft: 0;
	-moz-border-radius-bottomleft: 0;
	-webkit-border-start-start-radius: 0;
	-webkit-border-end-start-radius: 0;
	-moz-border-radius-topright: 5px;
	-moz-border-radius-bottomright: 5px;
	-webkit-border-start-end-radius: 5px;
	-webkit-border-end-end-radius: 5px;
	border-start-end-radius: 5px;
	border-end-end-radius: 5px;
	border: 1px solid #999;
	border-inline-start: none;
}
 
.pssc .pssc-sideMenuPanel .pssc-studListHideToggle em {
	position: absolute;
	top: 0;
	inset-inline-end: 0;
	height: 14px;
	width: 14px;
	background: url("../img/jquery/ui-icons_222222_256x240.png") no-repeat -33px -17px;
}

[dir=rtl] .pssc .pssc-sideMenuPanel .pssc-studListHideToggle em {
	background: url("../img/jquery/ui-icons_222222_256x240.png") no-repeat -96px -17px;
}

.pssc .pssc-sideMenuPanel .pssc-studListHideToggle:hover {
	width: 16px;
	height: 32px;
	z-index: 100;
	cursor: pointer;
}
 
.pssc .pssc-sideMenuPanel.expanded .pssc-studListHideToggle em {
	background-position: -96px -17px;
}

[dir=rtl] .pssc .pssc-sideMenuPanel.expanded .pssc-studListHideToggle em {
    background-position: -33px -17px;
}



/******************************************************************************/
/****************** Student DOM Object and Containers *************************/
/******************************************************************************/
.pssc .pssc-studentDiv {
	/* This is for the student div in both the seating area and holding area. */
	/* Styles overwritten in JS code: position, font-size, line-height */
	position: relative;			/* required */
}

.pssc .pssc-studentDiv .pssc-photoDiv {
	/* This is specific to the Student Photo's div. */
	/* Styles overwritten in JS code: width, height */
	margin: 0;					/* required */
	padding: 0;					/* required */
	border-style: none;			/* required */
}

.pssc .pssc-studentDiv .pssc-photoDiv img {
	width: 100%;				/* required */
	height: 100%;				/* required */
}

.pssc .pssc-studentDiv .pssc-studentNameWrapperDiv {
	/* This div wraps the the inner div. */
	/* Styles overwritten in JS code: width */
	position: absolute;			/* required */
	inset-inline-start: 0;					/* required */
	bottom: 0;					/* required */
	overflow: hidden;			/* required */
	margin: 0;					/* required */
	padding: 0;					/* required */
}

.pssc .pssc-studentDiv .pssc-studentNameWrapperDiv > div {
	/* This div wraps the Student Name's span. */
	/* Styles overwritten in JS code: width */
	margin: 0;					/* required */
	padding: 0;					/* required */
	text-align: center;			/* required */
	-moz-border-radius-bottomright: 3px;
	-moz-border-radius-bottomleft: 3px;
	-webkit-border-radius: 0px 0px 3px 3px;
	border-radius: 0px 0px 3px 3px;
	border-bottom-color: #666666;
	border-inline-start-color: #666666;
	border-top-color: -moz-use-text-color;
	background-color: #EEF;
	background-color: rgba(238, 238, 255, 0.7);
}

.pssc .pssc-studentDiv .pssc-studentNameWrapperDiv.longName > div {
	text-align: left;			/* required */
	-webkit-border-start-end-radius: 3px;
	-moz-border-radius-topright: 3px;
	border-start-end-radius: 3px;
}

.pssc .pssc-studentDiv .pssc-studentNameSpan {
	/* This is specific to the Student Name's span. */
	/* Styles overwritten in JS code: font-size, line-height */
	margin: 0;					/* required */
	white-space: nowrap;		/* required */
	padding: 2% 4% 0;
	font-weight: bold;
}

.pssc .pssc-seatingAreaCanvas .pssc-studentDiv .pssc-studentNameWrapperDiv.hovered {
	overflow: visible;
}

.pssc .pssc-studentDiv .pssc-studentNameWrapperDiv.hovered > div {
	/* When hovered, overflow will be set to visible and these additional styles can be set. */
	background-color: white;
	-moz-box-shadow: .2em .2em .4em rgba(0, 0, 0, .8);
	-webkit-box-shadow: .2em .2em .4em rgba(0, 0, 0, .8);
	box-shadow: .2em .2em .4em rgba(0, 0, 0, .8);
}

.pssc .pssc-studentDiv .pssc-studentMaskDiv, .pssc .pssc-studentDiv .pssc-preregMask {
	/* The studentMaskDiv is drawn over most student div content. */
	/* Styles for studentMaskDiv overwritten in JS code: font-size, line-height */
	position: absolute;			/* required */
	top: 0;						/* required */
	inset-inline-start: 0;					/* required */
	width: 100%;				/* required */
	height: 100%;				/* required */
	margin: 0;					/* required */
	padding: 0;					/* required */
	border: 0;					/* required */
}

.pssc .pssc-studentDiv .pssc-preregMask {
	/* This is unhidden if the student is pre-enrolled. */
	background-color: #777777;	/* required */
	opacity: 0.6;				/* required */
	filter: alpha(opacity=60);	/* required */
	display: none;				/* required */
}

.pssc .pssc-studentIconDiv {
	background-color: rgba(255, 255, 255, 0.7);
	-moz-border-radius: 4px;
	-webkit-border-radius: 4px;
	border-radius: 4px;
	position: absolute;
	top: 0;
}

.pssc .pssc-studentIconDiv:hover {
	background-color: rgba(255, 255, 255, 0.9);
}

.pssc .pssc-studentIconDiv em {
	background: url("../img/jquery/ui-icons_222222_256x240.png") no-repeat;
	display: block;
	height: 16px;
	width: 16px;
	overflow: hidden;
	cursor: pointer;
}

.pssc .pssc-studentList .pssc-studentIconDiv, .pssc .ClassToolsMode .pssc-studentIconDiv, .pssc .pssc-swapStudentButton {
	display: none;
}

.pssc .pssc-removeStudentButton {
	inset-inline-start: 0;
}

.pssc .pssc-removeStudentButton em {
	background-position: -80px -128px;
}

.pssc .pssc-removeStudentButton em:hover {
	background-position: -96px -128px;
}

.pssc .pssc-studentMaskDiv .pssc-swapStudentButton {
	inset-inline-start: 17px;
}

.pssc .LayoutMode.StudentPairSelected .pssc-seatDiv.objselected .pssc-swapStudentButton {
	display: block;
}

.pssc .pssc-swapStudentButton em {
	background-position: -96px -80px;
}

.pssc .pssc-swapStudentButton em:hover {
	background-position: -112px -80px;
}

/* Student Info Plugin (disabled) */
.pssc .pssc-studentDiv .pssc-studentMaskDiv .StudentInfoPlugin {
	float: right;
}

[dir=rtl] .pssc .pssc-studentDiv .pssc-studentMaskDiv .StudentInfoPlugin {
    float: left;
}

.pssc .pssc-studentDiv .pssc-studentMaskDiv .StudentInfoPlugin em {
	background: url("../img/jquery/ui-icons_222222_256x240.png") no-repeat -16px -144px;
	display: block;
	height: 16px;
	width: 16px;
	overflow: hidden;
	cursor: pointer;
}



/******************************************************************************/
/****************** Container for Seating Chart Objects ***********************/
/******************************************************************************/
/* Note: seatingAreaContent & seatingAreaContainer also contain the student list and zoom UI control. */
.pssc .pssc-seatingAreaContent {
	position: relative;		/* required */
	overflow: hidden;		/* required */
	width: 100%;			/* required */
	border-top: 1px solid #999;
}

.pssc .pssc-seatingAreaContainer, .pssc .pssc-viewportBoundaryBox {
	/* This is for the outer most seating area container. */
	/* Styles overwritten in JS code: margin-left */
	position: relative;	/* required */
	top: 0;				/* required */
	inset-inline-start: 0;			/* required */
	padding: 0;			/* required */
	overflow: visible;	/* required */
	margin: 0;
	min-width: 800px;
	height: 540px;
	background: #F9F9F9;
	filter: progid:DXImageTransform.Microsoft.gradient(GradientType=0,startColorstr='#F9F9F9', endColorstr='#DDDDDD');	/* IE6 & IE7 */
	-ms-filter: "progid:DXImageTransform.Microsoft.gradient(GradientType=0,startColorstr='#F9F9F9', endColorstr='#DDDDDD')";	/* IE8+ */
	background-image: -o-linear-gradient(bottom, rgb(221,221,221) 0%, rgb(249,249,249) 50%);	/* Opera 11.10 */
	background-image: -moz-linear-gradient(bottom, rgb(221,221,221) 0%, rgb(249,249,249) 50%);	/* FF 3.6+ */
	background-image: -webkit-gradient(linear, left bottom, left top, color-stop(0, rgb(221,221,221)), color-stop(0.5, rgb(249,249,249)) );	/* Safari 4+, Chrome 2+ */
	background-image: -webkit-linear-gradient(bottom, rgb(221,221,221) 0%, rgb(249,249,249) 50%);	/* Safari 5.1+, Chrome 10+ */
	background-image: -ms-linear-gradient(bottom, rgb(221,221,221) 0%, rgb(249,249,249) 50%);	/* IE10 */
	background-image: linear-gradient(bottom, rgb(221,221,221) 0%, rgb(249,249,249) 50%);
}

/* Seating Area */
.pssc .pssc-seatingAreaViewport {
	/* This is for the visible viewport of the seating drawing canvas area. It should have the same height as the seatingAreaContainer. */
	/* Note: All elements are drawn on the .pssc-seatingAreaCanvas, which has an offset from the viewport. */
	/* Styles overwritten in JS code: overflow */
	position: relative;	/* required */
	top: 0;				/* required */
	inset-inline-start: 0;			/* required */
	padding: 0;			/* required */
	overflow: auto;		/* required */
}

.pssc .pssc-seatingAreaCanvas, .pssc .pssc-seatingAreaGhostCanvas {
	position: absolute;	/* required */
	top: 0;				/* required */
	left: 0;			/* required */
}

.pssc .pssc-seatingAreaMask {
	position: absolute;	/* required */
}

/* Viewport Bounding Box display when using a zoomed preview (also set above with the container to get the background gradient) */
.pssc .pssc-viewportBoundaryBox {
	/* Styles overwritten in JS code: top, left, width, height */
	position: absolute;	/* required */
	border: 1px solid #CCC;
	-moz-box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
	-webkit-box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
	box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

.pssc .psseat-canvasEdgePoint {
	/* Styles overwritten in JS code: top, left */
	position: absolute;	/* required */
	width: 1px;			/* required */
	height: 1px;		/* required */
	border: none;
	padding: 0;
	margin: 0;
	background: url("../seatingchart/transparent.gif");
}



/******************************************************************************/
/************************* Seating Chart Objects ******************************/
/******************************************************************************/
/* All objects in the seating area */
.pssc-objectDiv {
	overflow: visible;	/* required */
	position: absolute;	/* required */
	padding: 0;			/* required */
	margin: 0;			/* required */
	-moz-border-radius: 5px;
	-webkit-border-radius: 5px;
	border-radius: 5px;
}

.pssc-objectDiv.objselected, .pssc-objectDiv.objhighlight {
	border: 2px solid #FF6600;
	-moz-box-shadow: 0 0 15px rgba(255, 102, 0, 0.9);
	-webkit-box-shadow: 0 0 15px rgba(255, 102, 0, 0.9);
	box-shadow: 0 0 15px rgba(255, 102, 0, 0.9);
	background: inherit;
	background: rgba(255, 102, 0, 0.2);
}

/* Seat Objects */
.pssc-seatDiv {
	/* This is a seat object with no student on it */
	/* Styles overwritten in JS code: width, height, top, left */
	border: 2px solid #666666;
	background: inherit;
	background: rgba(255, 255, 255, 0.7);
}

.pssc-seatDiv.seattaken {
	/* This overrides the above styles when a student is added to the seat */
	border-style: solid;
	background: #FFF;
}

.pssc-seatDiv.hovered {
	/* This is a seat object's style when a student is hovered over it to indicate it can be dropped on. */
	border-color: #F93;
	background: #F93;
	background: rgba(255, 153, 51, 0.2);
}

/* Ghost Objects */
.pssc-ghostDiv {
	/* This is a temporary placeholder object */
	/* Styles overwritten in JS code: width, height, top, left */
	border: 2px dashed #FFF;
	background: inherit;
	background: rgba(255, 255, 255, 0.5);
}

.pssc-ghostDiv.hovered {
	border-color: #F93;
}

/* TeacherDesk, Door, & WhiteBoard Objects */
.pssc-teacherDeskDiv, .pssc-doorDiv, .pssc-whiteboardDiv {
	/* Styles overwritten in JS code: width, height, top, left */
	padding: 2px;		/* required */
	border-style: none;
}

.pssc-teacherDeskDiv img, .pssc-doorDiv img, .pssc-whiteboardDiv img {
	width: 100%;		/* required */
	height: 100%;		/* required */
}

.pssc-teacherDeskDiv.objselected, .pssc-doorDiv.objselected, .pssc-whiteboardDiv.objselected, .pssc-teacherDeskDiv.objhighlight, .pssc-doorDiv.objhighlight, .pssc-whiteboardDiv.objhighlight {
	padding: 0px;
}

/* Text Objects */
.pssc-textObjDiv {
	/* Styles overwritten in JS code: font-size, line-height */
	white-space: nowrap;		/* required */
	padding: 0.3em 0.6em;
	font-weight: bold;
	cursor: default;
	background-color: #EEF;
	background-color: rgba(255, 255, 255, 0.7);
	border-width: 2px;
	border-style: solid;
	border-color: #EEF;
}

.pssc-textObjDiv.objselected span {
	cursor: text;
}

.pssc-textObjDiv.objselected, .pssc-textObjDiv.objhighlight {
	background-color: #FFF;
}

.pssc .pssc-textObjDiv:hover:not(.objselected):not(.objhighlight) {
	background-color: #FFF;
	background-color: rgba(255, 255, 255, 1.0);
	border-color: #FFF;
}

.pssc .pssc-textObjDiv button {
	margin: 0 0 0;
	margin-inline-start: 0.6px;
	padding: 0;
	vertical-align: middle;
}

/*[dir=rtl] .pssc .pssc-textObjDiv button{
    margin: 0 0.6em 0 0.6em;
}*/

.pssc .pssc-textObjDiv button em {
	margin: 0;
	display: inline-block;
	overflow: hidden;
}

.pssc .pssc-textObjDiv button.editIcon em {
	background-position: -64px -112px;
}

.pssc .pssc-textObjDiv button.saveIcon em {
	background-position: -64px -144px;
}



